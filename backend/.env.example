PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/pgapp
JWT_SECRET=change-this-to-a-long-random-string
# Comma separated list of frontend URLs allowed to call this API
CLIENT_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads

# OTP. In dev the OTP is printed in the console and returned in the API response.
# NEVER set OTP_DEV_MODE=true in production (it is ignored when NODE_ENV=production).
OTP_DEV_MODE=true
OTP_LENGTH=6

# Payments. Leave empty to use mock payments (dev/demo only).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set true only for demos without a real gateway.
ALLOW_MOCK_PAYMENTS=true
